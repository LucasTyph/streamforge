# Local development values only. Copy to .env (gitignored): cp .env.example .env
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=streamforge
AWS_SECRET_ACCESS_KEY=streamforge-dev-secret

POSTGRES_USER=streamforge
POSTGRES_PASSWORD=streamforge-dev
POSTGRES_DB=streamforge

# Host-side endpoints (API/web run on the host in `make dev`)
DATABASE_URL=postgres://streamforge:streamforge-dev@localhost:5432/streamforge
REDIS_URL=redis://localhost:6379
AWS_ENDPOINT_URL_S3=http://localhost:8333
AWS_ENDPOINT_URL_SQS=http://localhost:9324
AWS_ENDPOINT_URL_SNS=http://localhost:9911
# Endpoint the browser uses for presigned upload URLs
S3_PUBLIC_ENDPOINT=http://localhost:8333

RAW_BUCKET=streamforge-raw
PROCESSED_BUCKET=streamforge-processed
VIDEO_UPLOADED_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:streamforge-video-uploaded

JWT_SECRET=change-me-dev-only-32-chars-minimum!!
WEB_ORIGIN=http://localhost:3000
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Demo user created by `make seed`
SEED_USER_EMAIL=demo@streamforge.local
SEED_USER_PASSWORD=demo-password
