{
 "uid": "streamforge-pipeline",
 "title": "StreamForge / Pipeline",
 "description": "Queue depth vs autoscaled workers, throughput, latency, traces and logs for the video pipeline.",
 "tags": [
  "streamforge"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "namespace",
    "label": "Namespace",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(streamforge_queue_messages, namespace)",
     "refId": "ns"
    },
    "definition": "label_values(streamforge_queue_messages, namespace)",
    "refresh": 2,
    "current": {
     "text": "streamforge",
     "value": "streamforge"
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Queue depth vs worker replicas (KEDA autoscaling)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (queue) (sum by (queue, pod) (streamforge_queue_messages{namespace=\"$namespace\", dlq=\"false\", queue=~\"probe|transcode|thumbnail\", state=~\"visible|in_flight\"}))",
     "legendFormat": "{{queue}} queue"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (deployment) (kube_deployment_status_replicas{namespace=\"$namespace\", deployment=~\".+-worker\"})",
     "legendFormat": "{{deployment}} replicas"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "lineInterpolation": "stepAfter",
      "spanNulls": true
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byFrameRefID",
       "options": "B"
      },
      "properties": [
       {
        "id": "custom.axisPlacement",
        "value": "right"
       },
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          10,
          6
         ]
        }
       },
       {
        "id": "custom.fillOpacity",
        "value": 0
       },
       {
        "id": "custom.axisLabel",
        "value": "replicas"
       },
       {
        "id": "decimals",
        "value": 0
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "description": "Messages waiting or in flight per pipeline queue (left axis) and the replicas KEDA runs for each worker (right axis, dashed). Workers scale from 0 when work arrives and back to 0 after the cooldown."
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Videos ready",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(streamforge_videos{namespace=\"$namespace\", status=\"READY\"})",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 7,
   "type": "stat",
   "title": "Processing",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 9,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(streamforge_videos{namespace=\"$namespace\", status=~\"UPLOADED|PROCESSING\"}) or vector(0)",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 8,
   "type": "stat",
   "title": "Failed videos",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 9,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(streamforge_videos{namespace=\"$namespace\", status=\"FAILED\"}) or vector(0)",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 9,
   "type": "stat",
   "title": "Dead-lettered messages",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 9,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(max by (queue) (streamforge_queue_messages{namespace=\"$namespace\", dlq=\"true\"})) or vector(0)",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Jobs per second by task and outcome",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (task, outcome) (rate(streamforge_jobs_total{namespace=\"$namespace\"}[1m]))",
     "legendFormat": "{{task}} {{outcome}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Job duration p50 / p95 (successful)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le, task) (rate(streamforge_job_duration_seconds_bucket{namespace=\"$namespace\", outcome=\"success\"}[5m])))",
     "legendFormat": "{{task}} p95"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.50, sum by (le, task) (rate(streamforge_job_duration_seconds_bucket{namespace=\"$namespace\", outcome=\"success\"}[5m])))",
     "legendFormat": "{{task}} p50"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 4,
   "type": "table",
   "title": "Recent transcode traces (click a trace ID)",
   "datasource": {
    "type": "tempo",
    "uid": "tempo"
   },
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "tempo",
      "uid": "tempo"
     },
     "queryType": "traceql",
     "limit": 20,
     "query": "{ resource.deployment.environment = \"$namespace\" && name = \"transcode process\" }"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {},
   "description": "Each video is one trace: upload complete (catalog-api) -> SNS -> probe -> transcode / thumbnail -> job status."
  },
  {
   "id": 5,
   "type": "logs",
   "title": "Warnings and errors",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 12,
    "y": 21,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{k8s_namespace_name=\"$namespace\"} |~ \"(?i)\\\"level\\\":(\\\"(warn|error)\\\"|[45]0)\""
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true
   }
  }
 ]
}