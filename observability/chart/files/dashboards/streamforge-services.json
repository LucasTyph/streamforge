{
 "uid": "streamforge-services",
 "title": "StreamForge / Services (RED)",
 "description": "Rate, errors and duration for catalog-api and the pipeline workers, plus resource usage per pod.",
 "tags": [
  "streamforge"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "namespace",
    "label": "Namespace",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(kube_namespace_status_phase{namespace=~\"streamforge.*\"}, namespace)",
     "refId": "ns"
    },
    "definition": "label_values(kube_namespace_status_phase{namespace=~\"streamforge.*\"}, namespace)",
    "refresh": 1,
    "current": {
     "text": "streamforge",
     "value": "streamforge"
    }
   }
  ]
 },
 "panels": [
  {
   "id": 10,
   "type": "timeseries",
   "title": "catalog-api request rate by route",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (route) (rate(http_request_duration_seconds_count{namespace=\"$namespace\", route!~\"/metrics|/healthz|/readyz\"}[1m]))",
     "legendFormat": "{{route}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "catalog-api error ratio (5xx)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(http_request_duration_seconds_count{namespace=\"$namespace\", status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(http_request_duration_seconds_count{namespace=\"$namespace\"}[5m])), 1e-9)",
     "legendFormat": "5xx ratio"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "catalog-api p95 latency by route",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket{namespace=\"$namespace\", route!~\"/metrics|/healthz|/readyz\"}[5m])))",
     "legendFormat": "{{route}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Worker failures and retries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (task, outcome) (rate(streamforge_jobs_total{namespace=\"$namespace\", outcome!=\"success\"}[5m]))",
     "legendFormat": "{{task}} {{outcome}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Job-status events applied",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 6,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (outcome) (rate(streamforge_job_status_events_total{namespace=\"$namespace\"}[5m]))",
     "legendFormat": "{{outcome}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 15,
   "type": "timeseries",
   "title": "Live SSE clients",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 8,
    "w": 6,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(streamforge_sse_clients{namespace=\"$namespace\"})",
     "legendFormat": "clients"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 16,
   "type": "timeseries",
   "title": "Memory by pod",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"$namespace\", container!=\"\", container!=\"POD\"})",
     "legendFormat": "{{pod}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 17,
   "type": "timeseries",
   "title": "CPU by pod",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", container!=\"\", container!=\"POD\"}[2m]))",
     "legendFormat": "{{pod}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "cores"
    },
    "overrides": []
   },
   "options": {}
  }
 ]
}